import pandas as pd
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA

# Define the file paths for the original CSVs
train_path = r"C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\Baseline Feature Tests\Results\combined_flattened_data.csv"
holdout_path = r"C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\Baseline Feature Tests\Results\holdout_combined_flattened_data.csv"

# Read in the training and holdout data
train_df = pd.read_csv(train_path)
holdout_df = pd.read_csv(holdout_path)

# Assume that the last column is the label 'y'
X_train = train_df.iloc[:, :-1].values
y_train = train_df.iloc[:, -1].values

X_holdout = holdout_df.iloc[:, :-1].values
y_holdout = holdout_df.iloc[:, -1].values


# For two classes n_components will be 1
lda = LDA(n_components=1)
X_train_lda = lda.fit_transform(X_train, y_train)

# Transform the holdout data using the fitted LDA model
X_holdout_lda = lda.transform(X_holdout)

train_lda_df = pd.DataFrame(X_train_lda, columns=['LDA_feature'])
train_lda_df['y'] = y_train

holdout_lda_df = pd.DataFrame(X_holdout_lda, columns=['LDA_feature'])
holdout_lda_df['y'] = y_holdout

# Define paths to save the new CSV files
train_lda_csv_path = r"C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\flattened_train_LDA_data.csv"
holdout_lda_csv_path = r"C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\flattened_holdout_LDA_data.csv"

train_lda_df.to_csv(train_lda_csv_path, index=False)
holdout_lda_df.to_csv(holdout_lda_csv_path, index=False)

print("LDA transformation complete and CSV files saved")
