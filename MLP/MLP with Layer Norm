# Activation functions and their derivatives
def relu(z):
    """ReLU activation function"""
    return np.maximum(0, z)

def relu_derivative(a):
    """'a' here is the activation output"""
    return (a > 0).astype(float)

def leaky_relu(x, alpha=0.01):
    """Leaky ReLU activation function"""
    return np.where(x > 0, x, alpha * x)

def leaky_relu_derivative(a, alpha=0.01):
    """Derivative of Leaky ReLU"""
    return np.where(a > 0, 1, alpha)

def sigmoid(z):
    """Sigmoid activation function"""
    return 1 / (1 + np.exp(-z))

def sigmoid_derivative(a):
    """Derivative of Sigmoid"""
    return a * (1 - a)

def softmax(z):
    """Softmax activation function"""
    exp_z = np.exp(z - np.max(z, axis=1, keepdims=True))  # Stability trick
    return exp_z / np.sum(exp_z, axis=1, keepdims=True)

# Layer Normalization Function
def layer_norm(Z, gamma, beta, epsilon=1e-5):
    """
    Apply layer normalization.

    Parameters:
    - Z: Pre-activation values (numpy array)
    - gamma: Scaling parameter
    - beta: Shift parameter
    - epsilon: Small value for numerical stability

    Returns:
    - Normalized Z
    """
    mean = np.mean(Z, axis=1, keepdims=True)
    variance = np.var(Z, axis=1, keepdims=True)
    Z_norm = (Z - mean) / np.sqrt(variance + epsilon)
    return gamma * Z_norm + beta

# MLP class definition with Layer Normalization
class MLP:
    def __init__(self, layer_sizes, activation='relu'):
        """
        MLP class with Layer Normalization
        
        Parameters:
        - layer_sizes: List specifying the number of neurons in each layer
        - activation: Activation function ('relu', 'sigmoid', or 'leaky_relu')
        """
        self.layer_sizes = layer_sizes
        self.num_layers = len(layer_sizes)
        self.weights = []
        self.biases = []
        self.gammas = []
        self.betas = []

        if activation == 'relu':
            self.activation = relu
            self.activation_deriv = relu_derivative
        elif activation == 'sigmoid':
            self.activation = sigmoid
            self.activation_deriv = sigmoid_derivative
        elif activation == 'leaky_relu':
            self.activation = leaky_relu
            self.activation_deriv = leaky_relu_derivative
        else:
            raise ValueError('Undefined activation function')

        # Weight initialization (He initialization)
        for i in range(self.num_layers - 1):
            weight = np.random.randn(layer_sizes[i], layer_sizes[i + 1]) * np.sqrt(2. / layer_sizes[i])
            bias = np.zeros((1, layer_sizes[i + 1]))
            gamma = np.ones((1, layer_sizes[i + 1]))  # Scale parameter
            beta = np.zeros((1, layer_sizes[i + 1]))  # Shift parameter
            
            self.weights.append(weight)
            self.biases.append(bias)
            self.gammas.append(gamma)
            self.betas.append(beta)

    def forward(self, X):
        """
        Forward propagation with layer normalization
        """
        activations = [X]
        pre_activations = []
        A = X

        # Loop through hidden layers (except output layer)
        for i in range(self.num_layers - 2):
            Z = np.dot(A, self.weights[i]) + self.biases[i]
            Z_norm = layer_norm(Z, self.gammas[i], self.betas[i])  # Apply Layer Normalization
            pre_activations.append(Z_norm)
            A = self.activation(Z_norm)
            activations.append(A)

        # Output layer (Softmax)
        Z = np.dot(A, self.weights[-1]) + self.biases[-1]
        pre_activations.append(Z)
        A = softmax(Z)
        activations.append(A)

        return activations, pre_activations

    def backward(self, X, Y, activations, pre_activations):
        """
        Backpropagation with layer normalization.
        """
        m = X.shape[0]
        grads_W = [None] * len(self.weights)
        grads_b = [None] * len(self.biases)
        grads_gamma = [np.zeros_like(gamma) for gamma in self.gammas]
        grads_beta = [np.zeros_like(beta) for beta in self.betas]


        # Output layer gradient
        dA = activations[-1] - Y
        dZ = dA  

        grads_W[-1] = np.dot(activations[-2].T, dZ) / m
        grads_b[-1] = np.sum(dZ, axis=0, keepdims=True) / m
        dA_prev = np.dot(dZ, self.weights[-1].T)

        # Backpropagation through hidden layers
        for l in range(2, self.num_layers):
            Z = pre_activations[-l]
            dZ = dA_prev * self.activation_deriv(activations[-l])
            
            grads_W[-l] = np.dot(activations[(-l) - 1].T, dZ) / m
            grads_b[-l] = np.sum(dZ, axis=0, keepdims=True) / m
            
            # Layer normalization gradient (optional)
            grads_gamma[-l] = np.sum(dZ * Z, axis=0, keepdims=True) / m
            grads_beta[-l] = np.sum(dZ, axis=0, keepdims=True) / m
            
            dA_prev = np.dot(dZ, self.weights[-l].T)

        return grads_W, grads_b, grads_gamma, grads_beta

    def update_parameters(self, grads_W, grads_b, grads_gamma, grads_beta, learning_rate):
        """
        Update weights, biases, and normalization parameters.
        """
        for i in range(len(self.weights)):
            self.weights[i] -= learning_rate * grads_W[i]
            self.biases[i] -= learning_rate * grads_b[i]
            self.gammas[i] -= learning_rate * grads_gamma[i]
            self.betas[i] -= learning_rate * grads_beta[i]

    def train(self, X, Y, epochs=1000, learning_rate=0.01, batch_size=20, verbose=True):
        """
        Train the MLP model.
        """
        num_train_samples = X.shape[0]

        for i in range(epochs):
            permutation = np.random.permutation(num_train_samples)
            X_shuffled = X[permutation]
            Y_shuffled = Y[permutation]

            for j in range(num_train_samples // batch_size):
                indices = np.random.choice(num_train_samples, batch_size, replace=False)
                X_batch = X[indices]
                Y_batch = Y[indices]

                activations, pre_activations = self.forward(X_batch)
                grads_W, grads_b, grads_gamma, grads_beta = self.backward(X_batch, Y_batch, activations, pre_activations)
                self.update_parameters(grads_W, grads_b, grads_gamma, grads_beta, learning_rate)

            if verbose and i % 100 == 0:
                loss = -np.sum(Y_batch * np.log(activations[-1] + 1e-8)) / batch_size
                print(f"Epoch {i}: Loss = {loss:.4f}")

    def predict(self, X):
        """
        Predict class labels for evaluation data.
        """
        activations, _ = self.forward(X)
        return np.argmax(activations[-1], axis=1)
    
    # Grid search function for hyperparameter tuning
def grid_search_mlp(X_train, Y_train, X_val, Y_val, hyperparams):
    best_config = None
    best_accuracy = 0.0

    for layer_sizes in hyperparams['layer_sizes']:
        for lr in hyperparams['learning_rate']:
            for epochs in hyperparams['epochs']:
                print(f"\nTesting configuration: Layers = {layer_sizes}, Learning Rate = {lr}, Epochs = {epochs}")
                # Create a new instance of the MLP for each configuration
                model = MLP(layer_sizes, activation='leaky_relu')
                # Train on the training portion
                model.train(X_train, Y_train, epochs=epochs, learning_rate=lr, verbose=False)
                # Evaluate on the validation set
                preds = model.predict(X_val)
                true = np.argmax(Y_val, axis=1)
                acc = np.mean(preds == true)
                print(f"Validation Accuracy: {acc:.4f}")

                # Save the configuration if it's the best so far
                if acc > best_accuracy:
                    best_accuracy = acc
                    best_config = {
                        'layer_sizes': layer_sizes,
                        'learning_rate': lr,
                        'epochs': epochs,
                        'accuracy': acc
                    }
    return best_config

