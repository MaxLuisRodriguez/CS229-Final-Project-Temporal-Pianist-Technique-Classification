import pandas as pd
import numpy as np

# ----- Configuration -----
input_csv = "adv_seq_data.csv"  # Original dataset
train_csv = "adv_hmm_hand_landmarks_train.csv"  # Output training dataset
test_csv = "adv_hmm_hand_landmarks_test.csv"  # Output testing dataset
sequence_length = 20  # Each sequence contains 20 rows
train_ratio = 0.8  # 80% training, 20% testing

# ----- Load Data -----
df = pd.read_csv(input_csv)
num_images = df.shape[0]
num_sequences = num_images // sequence_length
print(f"Loaded {num_images} rows, forming {num_sequences} sequences.")

# ----- Reshape into Sequences -----
sequences = [df.iloc[i * sequence_length:(i + 1) * sequence_length] for i in range(num_sequences)]

# ----- Shuffle Sequences -----
np.random.seed(42)  # For reproducibility
np.random.shuffle(sequences)

# ----- Split Data -----
train_size = int(train_ratio * num_sequences)  # Number of sequences in training set
train_sequences = sequences[:train_size]
test_sequences = sequences[train_size:]

# ----- Save Training Data -----
df_train = pd.concat(train_sequences, ignore_index=True)
df_train.to_csv(train_csv, index=False)
print(f"Training data saved to '{train_csv}' with {len(train_sequences) * sequence_length} rows.")

# ----- Save Testing Data -----
df_test = pd.concat(test_sequences, ignore_index=True)
df_test.to_csv(test_csv, index=False)
print(f"Testing data saved to '{test_csv}' with {len(test_sequences) * sequence_length} rows.")
