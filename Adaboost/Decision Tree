import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

class DecisionTree:
    def __init__(self, max_depth=None):
        """
        Initialize the Decision Tree with an optional max depth parameter.
        """
        self.max_depth = max_depth
        
    def fit(self, X, y):
        """
        Fit the decision tree model to the training data."
        """
        y = y.astype(np.int64)  # Convert labels to integers
        self.n_classes_ = len(np.unique(y))  # Number of unique classes.
        self.n_features_ = X.shape[1]        # Number of features.
        self.tree_ = self._grow_tree(X, y)     # Build the tree.
        
    def predict(self, X):
        """
        Predict class labels for samples in X.
        """
        return [self._predict(inputs) for inputs in X]
        
    def _misclassification_loss(self, y):
        """
        Calculate misclassification loss.
        """
        loss = 1 - (np.max(np.bincount(y)) / len(y))
        return loss
        
    def _best_split(self, X, y):
        """
        Find the best split for a node based on misclassification loss.
        """
        best_idx, best_thr = None, None
        best_loss = np.inf  # Initialize with infinity.
        for feature_index in range(self.n_features_): # iterate through all hand sequence probability features
            thresholds = np.unique(X[:, feature_index])
            for thr in thresholds: # iterate through possible split points
                left_indices = X[:, feature_index] <= thr # all data points with feature less than or equal to threshold
                right_indices = X[:, feature_index] > thr # rest of data points
                # Avoid splits that don't partition the data.
                if np.sum(left_indices) == 0 or np.sum(right_indices) == 0:
                    continue
                loss_left = self._misclassification_loss(y[left_indices])
                loss_right = self._misclassification_loss(y[right_indices])
                weighted_loss = ((np.sum(left_indices) / len(y)) * loss_left + 
                                 (np.sum(right_indices) / len(y)) * loss_right)
                if weighted_loss < best_loss:
                    best_loss = weighted_loss
                    best_idx = feature_index
                    best_thr = thr
        return best_idx, best_thr
        
    def _grow_tree(self, X, y, depth=0):
        """
        Recursively build the decision tree."
        """
        num_samples_per_class = [np.sum(y == i) for i in range(self.n_classes_)]
        predicted_class = np.argmax(num_samples_per_class)

        # set tree node predicted class equal to class with most num of data in node
        root_node = Node(predicted_class=predicted_class)
        if depth < self.max_depth:
            best_idx, best_thr = self._best_split(X, y)
            if best_idx is not None:
                # separate data in node into left and right leaf nodes based on best split threshold
                indices_left = X[:, best_idx] <= best_thr
                indices_right = X[:, best_idx] > best_thr
                root_node.feature_index = best_idx
                root_node.threshold = best_thr
                root_node.left = self._grow_tree(X[indices_left], y[indices_left], depth + 1)
                root_node.right = self._grow_tree(X[indices_right], y[indices_right], depth + 1)
        return root_node
        
    def _predict(self, inputs):
        # Traverse the tree to predict the class for one sample.
        node = self.tree_
        while not node.is_leaf_node():
            if inputs[node.feature_index] <= node.threshold:
                node = node.left
            else:
                node = node.right
        return node.predicted_class
    
class Node:
    def __init__(self, *, predicted_class):
        self.predicted_class = predicted_class  # Predicted class at this node
        self.feature_index = None               # Feature index for split
        self.threshold = None                   # Threshold value for split
        self.left = None                        # Left child
        self.right = None                       # Right child

    def is_leaf_node(self):
        # Check if the node is a leaf node.
        return self.left is None and self.right is None

if __name__ == "__main__":
    # Import necessary libraries
    from sklearn.metrics import classification_report, confusion_matrix

    # Load train dataset
    file_name = r'C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\PCA_6comp_train_data.csv'
    df = pd.read_csv(file_name)
    
    # Assume the last column is the label and the remaining columns are features
    num_features = df.shape[1] - 1
    feature_columns = df.columns[:num_features]
    target_column = df.columns[num_features]
    
    X = df[feature_columns].values
    y = df[target_column].values
    
    # Handle hold-out testing option
    hold_test = True
    hold_file_name = r'C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\PCA_6comp_holdout_data.csv'
    
    if hold_test == False:
        # Split the data into training and testing sets
        X_train, X_test, y_train, y_test = train_test_split(
            X, y, test_size=0.2, random_state=233
        )
    else:
        # Use traintest data as train data and evaluate on hold data
        df2 = pd.read_csv(hold_file_name)
        X_train = X
        y_train = y
        
        # Make sure we use the same features as in training data
        X_test = df2[feature_columns].values
