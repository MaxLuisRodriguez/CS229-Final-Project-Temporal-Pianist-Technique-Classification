import pandas as pd
from sklearn.model_selection import train_test_split

# ----- Load probability datasets -----
advanced_probs_path = "claude_advanced_prob_data.csv"
beginner_probs_path = "claude_beginner_prob_data.csv"

df_advanced = pd.read_csv(advanced_probs_path)
df_beginner = pd.read_csv(beginner_probs_path)

# ----- Add labels -----
df_advanced["y"] = 1  # Advanced pianists
df_beginner["y"] = 0  # Beginner pianists

# ----- Combine datasets -----
df_combined = pd.concat([df_advanced, df_beginner], ignore_index=True)

# ----- Shuffle the data -----
df_combined = df_combined.sample(frac=1, random_state=42).reset_index(drop=True)

# ----- Split into training and testing sets (80% train, 20% test) -----
train_set, test_set = train_test_split(df_combined, test_size=0.2, random_state=42)

# ----- Save train and test sets -----
train_set.to_csv("claude_GDA_train_set.csv", index=False)
test_set.to_csv("claude_GDA_test_set.csv", index=False)

df_combined.to_csv("Adaboost_traintest_combined.csv", index=False)

print("Train and test sets successfully created and saved.")
