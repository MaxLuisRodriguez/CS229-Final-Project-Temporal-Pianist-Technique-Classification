import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# DecisionTree class definition
class DecisionTree:
    def __init__(self, max_depth=None):
        self.max_depth = max_depth
    
    def fit(self, X, y):
        y = y.astype(np.int64)
        self.n_classes_ = len(np.unique(y))
        self.n_features_ = X.shape[1]
        self.tree_ = self._grow_tree(X, y)
    
    def predict(self, X):
        return [self._predict(inputs) for inputs in X]
    
    def _misclassification_loss(self, y):
        return 1 - (np.max(np.bincount(y)) / len(y))
    
    def _best_split(self, X, y):
        best_idx, best_thr = None, None
        best_loss = np.inf
        for feature_index in range(self.n_features_):
            thresholds = np.unique(X[:, feature_index])
            for thr in thresholds:
                left_indices = X[:, feature_index] <= thr
                right_indices = X[:, feature_index] > thr
                if np.sum(left_indices) == 0 or np.sum(right_indices) == 0:
                    continue
                loss_left = self._misclassification_loss(y[left_indices])
                loss_right = self._misclassification_loss(y[right_indices])
                weighted_loss = ((np.sum(left_indices) / len(y)) * loss_left + 
                                 (np.sum(right_indices) / len(y)) * loss_right)
                if weighted_loss < best_loss:
                    best_loss = weighted_loss
                    best_idx = feature_index
                    best_thr = thr
        return best_idx, best_thr
    
    def _grow_tree(self, X, y, depth=0):
        num_samples_per_class = [np.sum(y == i) for i in range(self.n_classes_)]
        predicted_class = np.argmax(num_samples_per_class)
        root_node = Node(predicted_class=predicted_class)
        if depth < self.max_depth:
            best_idx, best_thr = self._best_split(X, y)
            if best_idx is not None:
                indices_left = X[:, best_idx] <= best_thr
                indices_right = X[:, best_idx] > best_thr
                root_node.feature_index = best_idx
                root_node.threshold = best_thr
                root_node.left = self._grow_tree(X[indices_left], y[indices_left], depth + 1)
                root_node.right = self._grow_tree(X[indices_right], y[indices_right], depth + 1)
        return root_node
    
    def _predict(self, inputs):
        node = self.tree_
        while not node.is_leaf_node():
            if inputs[node.feature_index] <= node.threshold:
                node = node.left
            else:
                node = node.right
        return node.predicted_class

class Node:
    def __init__(self, *, predicted_class):
        self.predicted_class = predicted_class
        self.feature_index = None
        self.threshold = None
        self.left = None
        self.right = None

    def is_leaf_node(self):
        return self.left is None and self.right is None

# Load train dataset
file_name = r'C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\New Data\TrainTest Data\Convolved\combined_conv_data.csv'
df = pd.read_csv(file_name)

num_features = df.shape[1] - 1
feature_columns = df.columns[:num_features]
target_column = df.columns[num_features]
X = df[feature_columns].values
y = df[target_column].values

# Load holdout dataset
hold_test = True
hold_file_name = r'C:\Users\maxlr\OneDrive\Desktop\CS229\229 Project Scripts\New Data\Holdout Data\Convolved\holdout_combined_conv_data.csv'
df2 = pd.read_csv(hold_file_name)
X_train = X
y_train = y
X_test = df2[feature_columns].values
y_test = df2[target_column].values

# Define hyperparameter range
max_depth_values = [1, 2, 3, 4, 5, 6, 8, 10, 12, 15]

# Store results
results = []

for max_depth in max_depth_values:
    clf = DecisionTree(max_depth=max_depth)
    clf.fit(X_train, y_train)
    
    # Validation accuracy
    y_pred_train = clf.predict(X_train)
    train_accuracy = accuracy_score(y_train, y_pred_train)
    
    # Holdout accuracy
    y_pred_test = clf.predict(X_test)
    test_accuracy = accuracy_score(y_test, y_pred_test)
    
    results.append([max_depth, train_accuracy, test_accuracy])

# Convert to DataFrame
results_df = pd.DataFrame(results, columns=['Max Depth', 'Train Accuracy', 'Test Accuracy'])

# Plot results
plt.figure(figsize=(12, 6))
plt.plot(results_df['Max Depth'], results_df['Test Accuracy'], marker='o', label='Test Accuracy')
plt.plot(results_df['Max Depth'], results_df['Train Accuracy'], marker='s', label='Train Accuracy')

plt.xlabel('Max Depth')
plt.ylabel('Accuracy')
plt.title('Decision Tree Hyperparameter Tuning (Max Depth)')
plt.legend()
plt.grid()
plt.show()
